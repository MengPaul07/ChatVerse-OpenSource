# Optional server-side default. The protocol driver selects the wire format;
# ordinary OpenAI-compatible services use openai-chat.
CHATVERSE_PROVIDER_PROTOCOL=openai-chat
CHATVERSE_PROVIDER_NAME=
CHATVERSE_API_KEY=
CHATVERSE_BASE_URL=
CHATVERSE_MODEL=
CHATVERSE_PROVIDER_OPTIONS_JSON={}

# Legacy startup inputs remain accepted as environment aliases.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
DIRECTOR_MODEL=
CHARACTER_MODEL=
# Optional. Falls back to DIRECTOR_MODEL when omitted.
AUTHORING_MODEL=
AUTHORING_RESEARCH_MODEL=
# Legacy DeepSeek research-model alias, retained as a server startup input.
DEEPSEEK_RESEARCH_MODEL=
RESEARCH_MODEL=
CHATVERSE_DEBUG=false
CHATVERSE_TRACE_PROMPTS=false
CHATVERSE_TRACE_RESPONSES=false
CHATVERSE_TRACE_TOOL_CALLS=false
CHATVERSE_DEBUG_MEMORY=false
